# Description: This file contains the settings of <code>-htz-srv-vpn, no secrets

ROLE=vpn
BANNER="<CODE> VPN"
SWAP_SIZE=1G
SUDO_NOPASSWD=yes
ALLOW_UDP="51820"
WG_ADDRESS=10.21.0.1/24
WG_PORT=51820
# on-site servers in the tunnel, reached from the other peers
WG_SERVER_PEERS=""
SECRETS="slack smtp"
