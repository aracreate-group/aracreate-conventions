# Description: This file contains the settings of <server>, no secrets

ROLE=<role>
BANNER="<CODE> <ROLE>"
SWAP_SIZE=2G
# the admins, and a service user where the role runs jobs
SSH_USERS="<admin> <service-user>"
# yes while the server is set up; sudo asks for a password once setup ends
SUDO_NOPASSWD=yes
# 2200 where an app holds 22
SSH_PORT=22
# yes for a server running apps in Docker Compose
DOCKER=no
# the private network's gateway, its first address
NAT_GATEWAY=10.20.0.1
# certificates to watch, host:port, and backups by age, <glob>:<max hours>
CERT_HOSTS=""
BACKUPS=""
# <name> root only, <name>:<group> readable by that group
SECRETS="slack smtp"
