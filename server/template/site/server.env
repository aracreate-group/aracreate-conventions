# Description: This file contains the settings of <server>, no secrets

ROLE=<role>
BANNER="<CODE> <HARDWARE>"
PLATFORM=rpi
# the Pi's own zram swap
SWAP_SIZE=0
SSH_USERS="<admin> <service-user>"
SUDO_NOPASSWD=yes
# the tunnel, and the admins' own devices on site
SSH_FROM="10.21.0.0/24 <admin-device-address>"
SECRETS="slack:<service-user> smtp"
# nightly copy of /opt/<code>/etc and /opt/<code>/state to the site's NAS, checked for age
STATE_COPY_TO=<nas-path>/<server>
BACKUPS="<nas-path>/<server>/copied-at:26"
# a WireGuard peer of the vpn server, so it is reached through the tunnel
TUNNEL_ADDRESS=<10.21.0.x>/32
TUNNEL_ENDPOINT=<vpn-public-ip>:51820
TUNNEL_PEER_KEY=<vpn-public-key>
