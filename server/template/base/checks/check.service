# Description: This file contains the unit that runs <code>-check

[Unit]
Description=Run the @NAME@ server checks and alert on change
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/@CODE@/etc/server.env
ExecStart=/opt/@CODE@/bin/@CODE@-check
