# Description: This file contains the timer that runs <code>-check every 5 minutes

[Unit]
Description=Run the @NAME@ server checks every 5 minutes

[Timer]
OnBootSec=30s
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
