# Description: This file contains @CODE@-set-secret, which sets one key in a
#              secret file to the value on stdin, keeping the file's owner and
#              mode; usage: @CODE@-set-secret <name> <key>

set -euo pipefail

name="${1:?usage: @CODE@-set-secret <name> <key>}"
key="${2:?usage: @CODE@-set-secret <name> <key>}"
[[ "$name" =~ ^[a-z0-9-]+$ ]] || { echo "bad name: $name"; exit 1; }
[[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "bad key: $key"; exit 1; }
f="/opt/@CODE@/secrets/$name.env"
[ -f "$f" ] || { echo "no $f: add $name to SECRETS in server.env and run make baseline"; exit 1; }

IFS= read -r value
[ -n "$value" ] || { echo "empty value, $f left as it was"; exit 1; }
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
grep -v "^$key=" "$f" > "$tmp" || true
printf '%s=%s\n' "$key" "$value" >> "$tmp"
# Written through cat so the file keeps its owner and mode
cat "$tmp" > "$f"
echo "$key set in $f"
