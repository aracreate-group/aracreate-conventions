# Description: This file contains the code's settings, shared by every server,
#              no secrets; a server's own server.env can override any of them

# the owner's short code, conventions/server §1; every path and name derives from it
CODE="<code>"
# the name in unit descriptions and the alert mail's From
NAME="<name>"
# one admin login per person, space-separated: sudo, docker
ADMINS="<admin>"
# change a range where it overlaps a network a peer joins, conventions/server §2
PRIVATE_RANGE=10.20.0.0/16
TUNNEL_RANGE=10.21.0.0/24
# the code's alert channel, #<code>-agent, by ID
SLACK_CHANNEL="<channel-id>"
# the alerts mailbox sends, through SMTP on 587 with an app password per server
SMTP_HOST="<smtp-host>"
SMTP_USER="<alerts-mailbox>"
MAIL_FROM="<alerts-mailbox>"
MAIL_TO="<admin-mailbox>"
